# Copy this file to ".env" and fill in your real values.
# Get these from https://developer.schwab.com after registering your app.

SCHWAB_MARKET_DATA_APP_KEY=your_market_data_app_key_here
SCHWAB_MARKET_DATA_APP_SECRET=your_market_data_app_secret_here

# Separate Schwab app credentials with Accounts and Trading Production access.
SCHWAB_TRADING_APP_KEY=your_trading_app_key_here
SCHWAB_TRADING_APP_SECRET=your_trading_app_secret_here

# Must EXACTLY match the callback URL registered on your Schwab app.
# schwab-py needs an HTTPS localhost callback, e.g.:
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182

# Separate token files are required because each app uses its own credentials.
SCHWAB_MARKET_DATA_TOKEN_PATH=./schwab_market_data_tokens.json
SCHWAB_TRADING_TOKEN_PATH=./schwab_trading_tokens.json

# Paper mode is enabled by default. Set false only when you intentionally want
# confirmed orders and cancellations sent to Schwab.
PAPER_TRADING=true

# --- Autopilot ---
# AUTOPILOT_MODE=paper
# DANGER: sends REAL orders with no per-order confirmation. Needs AUTOPILOT_MODE=live,
# PAPER_TRADING=false and the confirm phrase below. Test in paper for weeks first.
# Contract quality filters for autopilot (set a value to 0 to disable that check).
AUTOPILOT_MIN_ABS_DELTA=0.25
AUTOPILOT_MAX_ABS_DELTA=0.60
AUTOPILOT_MIN_DAYS_TO_EXPIRY=2
AUTOPILOT_MIN_OPEN_INTEREST=500
AUTOPILOT_MAX_ASK_ABOVE_MID_PCT=5
# Stop opening new trades for the day once the account is up this % (0 disables).
AUTOPILOT_DAILY_PROFIT_TARGET_PCT=2
# true = ignore options already listed when autopilot is started; false = buy any
# listed option that passes the filters (its price must be rising).
AUTOPILOT_SKIP_EXISTING=false
# Assumed round-trip cost per contract (fees plus slippage) used in the results panel.
AUTOPILOT_COST_PER_CONTRACT=1.30
# Only buy calls while the stock is above its 20 EMA (puts: below), as shown in the
# dashboard's stock EMA column.
AUTOPILOT_REQUIRE_EMA=true
# Only buy options whose table Momentum is UP (rising over the last 10 minutes).
AUTOPILOT_REQUIRE_UP=true
AUTOPILOT_LIVE_AUTO=false
AUTOPILOT_LIVE_AUTO_CONFIRM=
AUTOPILOT_LIVE_ACCOUNT_INDEX=0: places simulated orders itself.
# AUTOPILOT_MODE=live: only PROPOSES trades; each one must be reviewed and
# confirmed in the order ticket. Requires PAPER_TRADING=false and trading creds.
AUTOPILOT_ENABLED=false
AUTOPILOT_MODE=paper
AUTOPILOT_PROPOSAL_TTL_SECONDS=300
# Spend at most this % of the account value on new entries per day.
AUTOPILOT_DAILY_BUDGET_PCT=50
# Simulated account size for the paper-mode budget.
AUTOPILOT_PAPER_ACCOUNT_SIZE=10000
AUTOPILOT_MAX_OPEN_POSITIONS=10
# Optional extra cap on stop-out loss per order (0 = off).
AUTOPILOT_RISK_PER_TRADE=0
AUTOPILOT_MAX_CONTRACTS=1
AUTOPILOT_MAX_DAILY_LOSS=250
# OCO exits as a percent of the entry price.
AUTOPILOT_TAKE_PROFIT_PCT=15
AUTOPILOT_STOP_LOSS_PCT=10
AUTOPILOT_LAST_ENTRY_TIME=14:30

# --- Email alerts (optional) ---
# Set to true to get an email whenever a new contract starts qualifying
# on the dashboard. Leave false (or delete these lines) to skip email.
EMAIL_ENABLED=false

# Example for Gmail: smtp.gmail.com, port 587, and you MUST use an
# "app password" (not your normal Gmail password) -- generate one at
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_app_password_here
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com
